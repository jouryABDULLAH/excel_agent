GROQ_API_KEY=
EXCEL_AGENT_MODEL=openai/gpt-oss-120b

# The spreadsheet to start on, by name. Leave it empty to choose one in the
# app.
EXCEL_AGENT_SPREADSHEET=

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=excel-agent

# The region the key belongs to. A key from one region posting to another is
# refused with 403 and nothing is recorded, which reads as tracing being
# broken rather than pointed at the wrong place. Match it to the host in your
# LangSmith URL: eu.api or apac.api for those, and the default below for US.
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
